# Copy to .env and fill in real values. NEVER commit .env.
# See README.md → "Slack & Notion (Module 15)" and MODULES.md.

# Supabase Postgres — Connect → Session pooler → URI
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Module 15 (course text: Module 14) — Slack / Notion / GitHub
# Keys in env only. After filling, run: node scripts/module14/run-assignment.js
# ---------------------------------------------------------------------------

# Slack — Bot User OAuth Token (xoxb-...), signing secret, channel ID (C...)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_WORKSPACE_NAME=

# Notion — Internal integration token + database ID
# Important: share the database with the integration under Connections
NOTION_TOKEN=
NOTION_DATABASE_ID=

# GitHub — optional if git/gh already authenticated
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

BOT_NAME=Ops Desk Agent
PROJECT_NAME=Silverleaf Ops Ticket Desk
OWNER_NAME=Kitili Mbula
CHECKIN_INTERVAL=30m
